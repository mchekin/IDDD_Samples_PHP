{
  "name": "mchekin/implementing-ddd",
  "description": "Sample project implementing DDD - PHP translation of Vaughn Vernon's Java samples",
  "type": "project",
  "keywords": ["ddd", "domain-driven-design", "vaughn-vernon", "samples", "php"],
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Chekin",
      "email": "mchekin@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "nesbot/carbon": "^3.0",
    "ramsey/uuid": "^4.7",
    "webmozart/assert": "^1.11"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12",
    "phpstan/phpstan-strict-rules": "^1.6",
    "rector/rector": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage",
    "analyse": "phpstan analyse",
    "fix": "rector process"
  },
  "config": {
    "platform": {
      "php": "8.4.0"
    },
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
